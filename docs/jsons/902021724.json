    {
      "type": "P",
      "source": "<p class=\"aaaaa-T2\" data-pid=\"23\">Статья 3. Исполнение обязанности по уплате налогов и</p>",
      "pid": "23",
      "spacesBefore": 0,
      "text": "Статья 3. Исполнение обязанности по уплате налогов и",
      "format": "headertext",
