    {
      "type": "P",
      "source": "<p class=\"aaaaa-T2\" data-pid=\"10\">Статья 1. Основные понятия, используемые </p>",
      "pid": "10",
      "spacesBefore": 0,
      "text": "Статья 1. Основные понятия, используемые ",
      "format": "headertext",
      "align": "center",
      "isBold": true,
